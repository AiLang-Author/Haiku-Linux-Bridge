# .gitignore for Haiku-Linux-Bridge

# QEMU runtime disk & log files
*.qcow2
*.log
*.sock

# Downloads and heavy source trees
downloads/
payload/
obj/

# Compiled C test executables
tests/hello_linux
tests/hello_min
scripts/__pycache__/
tests/test_file
tests/test_mem
tests/test_sys
tests/test_net
tests/test_ioctl
tests/hello_dyn
tests/hello_stat
tests/compiled_out.x
tests/test_vfs
tests/test_epoll
tests/test_signal
tests/sys_compat_run

# LTP guest results collected over the network
results/

# OS & Editor files
.DS_Store
*.swp
*~
